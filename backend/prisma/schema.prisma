generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Colaborador {
  id            String        @id @default(uuid())
  nome          String
  email         String?       @unique
  // Login sem depender de e-mail: minúsculo, único; contas antigas sem usuário entram pelo e-mail.
  // Formato garantido também por CHECK no banco (migration 20261106130000_usuario_formato)
  usuario       String?       @unique
  senha         String?
  especialidade String
  cargo         String?
  tipoEscala    String?       @default("6x1")
  // Horário padrão dos dias de trabalho ("HH:MM-HH:MM"); nulo = sem turno (horário da casa). Ajuste do dia tem prioridade
  turnoPadrao   String?
  folgasDomingoNoMes Int?     @default(2)
  cargaHorariaSemanal Int?    @default(40)
  // Legado (texto livre): copiado para "habilidadesCadastradas" na migration 20261121120000_habilidades; não é mais lido
  habilidadesLegado String[]  @default([]) @map("habilidades")
  habilidadesCadastradas Habilidade[] @relation("ColaboradorHabilidades")
  papel         String        @default("collaborator")
  ativo         Boolean       @default(true)
  diasTrabalho  String?       @default("1,2,3,4,5,6")
  // Incrementada ao trocar senha/e-mail ou reativar a conta: tokens com versão antiga deixam de valer
  versaoToken   Int           @default(0)
  // Senha criada ou redefinida por outra pessoa (supervisão, linha de comando): a própria pessoa troca no 1º acesso
  trocarSenha   Boolean       @default(false)
  agendamentos  Agendamento[]
  bloqueios     Bloqueio[]
  trocasTurno   SolicitacaoTroca[]
  escalaOverrides EscalaOverride[]
}

// Habilidades cadastradas pela supervisão; arquivar (ativa = false) tira das regras sem apagar os vínculos
model Habilidade {
  id              String        @id @default(uuid())
  nome            String
  // nome em minúsculas e sem espaços sobrando: impede "Drenagem" e "drenagem" duplicadas
  nomeNormalizado String        @unique
  ativa           Boolean       @default(true)
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt
  colaboradores   Colaborador[] @relation("ColaboradorHabilidades")
  servicos        Servico[]     @relation("ServicoHabilidades")
}

model Cliente {
  id           String        @id @default(uuid())
  // Código curto para identificar o cliente na tela e no atendimento (o id é técnico)
  codigo       Int           @unique @default(autoincrement())
  nome         String
  telefone     String?
  cpf          String?
  email        String?
  observacao   String?
  // Preenchido quando o cliente é excluído mas tem histórico: os dados pessoais são apagados e os atendimentos ficam
  removidoEm   DateTime?
  // LGPD: cliente pediu para não receber lembretes no WhatsApp
  naoReceberWhatsapp Boolean @default(false)
  agendamentos Agendamento[]
  fichas       FichaPreenchida[]
}

model Servico {
  id                   String        @id @default(uuid())
  nome                 String        @unique
  preco                Float
  duracao              Int?          @default(60)
  icone                String?       @default("spa")
  descricao            String?       @default("")
  categoria            String?       @default("")
  tempoHigienizacaoMin Int?          @default(0)
  comissaoPercentual   Float?
  modoElegibilidade    String        @default("livre")
  cargosPermitidos     String[]      @default([])
  // Legado (texto livre): copiado para "habilidadesExigidas" na migration 20261121120000_habilidades; não é mais lido
  habilidadesPermitidasLegado String[] @default([]) @map("habilidadesPermitidas")
  habilidadesExigidas  Habilidade[]  @relation("ServicoHabilidades")
  profissionaisPermitidos String[]   @default([])
  // Inativo: some do totem e de novos agendamentos, mas continua no histórico
  ativo                Boolean       @default(true)
  // Posição no catálogo (menor primeiro)
  ordem                Int           @default(0)
  agendamentos         Agendamento[]
}

model Sala {
  id           String        @id @default(uuid())
  nome         String        @unique
  numero       Int?
  capacidade   Int           @default(1)
  ativa        Boolean       @default(true)
  descricao    String?
  agendamentos Agendamento[]
}

model Agendamento {
  id               String      @id @default(uuid())
  data             DateTime
  // Totem: quando o cliente autorizou o uso dos dados pessoais e de saúde (prova do consentimento, LGPD art. 8º e 11)
  consentimentoDadosEm DateTime?
  // Versão do texto de consentimento aceito (shared/consentimento.ts)
  consentimentoVersao  String?
  status           String?     @default("scheduled")
  colaboradorId    String
  clienteId        String
  salaId           String?
  valorTotal       Float?
  // Comissão do profissional gravada junto com o valor (percentual do serviço no dia)
  valorComissao    Float?
  valorSinal       Float?
  statusPagamento  String?     @default("pendente")
  metodoPagamento  String?
  pixQrCode        String?
  pixCopiaECola    String?
  lockExpiresAt    DateTime?
  reservaOrigem    String?     @default("interno")
  observacoesSaude String?
  // Cliente respondeu "Não poderei ir" ao lembrete do WhatsApp (o agendamento continua; a equipe decide)
  clienteAvisouAusenciaEm DateTime?
  atualizadoEm     DateTime    @default(now()) @updatedAt
  // Reserva do totem que originou o agendamento (garante uma confirmação por reserva)
  reservaToken     String?     @unique
  // Referência da cobrança no gateway (aleatória): o token da reserva é credencial e não sai do servidor
  referenciaPagamento String?  @unique

  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  cliente       Cliente     @relation(fields: [clienteId], references: [id])
  sala          Sala?       @relation(fields: [salaId], references: [id])
  servicos      Servico[]
}

model Bloqueio {
  id            String      @id @default(uuid())
  data          String
  horaInicio    String
  horaFim       String
  motivo        String
  colaboradorId String

  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
}

model SolicitacaoTroca {
  id                String      @id @default(uuid())
  colaboradorId      String
  dataOriginal       String
  dataSolicitada     String
  motivo             String
  status             String      @default("pendente")
  respostaObservacao String?
  respondidoPorId    String?
  criadoEm           DateTime    @default(now())
  atualizadoEm       DateTime    @updatedAt

  colaborador        Colaborador @relation(fields: [colaboradorId], references: [id])

  @@index([colaboradorId])
  @@index([status])
}

// Turnos padrão da escala (Regras e Turnos): opções do editor de dia e da edição em lote
model Turno {
  id       String   @id @default(uuid())
  nome     String
  inicio   String // HH:MM
  fim      String // HH:MM (antes do início = vira a noite)
  criadoEm DateTime @default(now())

  @@unique([inicio, fim])
}

model EscalaOverride {
  key           String      @id
  colaboradorId String
  data          String
  tipo          String?
  turno         String?
  descricao     String?
  atualizadoEm  DateTime    @updatedAt

  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])

  @@index([colaboradorId])
  @@index([data])
}

model ConfiguracaoAutoatendimento {
  id                           String   @id @default("default")
  ativo                        Boolean  @default(true)
  exigirPagamento              Boolean  @default(true)
  percentualSinal              Float    @default(40.0)
  tempoLockMinutos             Int      @default(10)
  permitirCancelamento         Boolean  @default(true)
  tempoMinimoCancelamentoHoras Int      @default(4)
  instrucoesCheckin            String?  @default("Chegue com 10 minutos de antecedência para recepção e confirmação do seu atendimento.")
  mensagemBoasVindas           String?  @default("Bem-vindo ao nosso sistema de autoatendimento. Reserve seu horário com facilidade.")
  atualizadoEm                 DateTime @updatedAt
}

model ConfiguracaoEmpresa {
  id                   String   @id @default("default")
  nomeEmpresa          String   @default("OmniGestão - Atendimentos & Agendamentos")
  segmento             String   @default("geral") // 'geral', 'beleza_barbearia', 'clinica_saude', 'spa_bemestar', 'estudio_fitness'
  slogan               String?  @default("Gestão inteligente e experiência de excelência para seus clientes.")
  icone                String?  @default("storefront")
  termoAtendimento     String?  @default("Atendimento")
  termoProfissional    String?  @default("Profissional")
  termoEspaco          String?  @default("Sala / Espaço")
  termoServico         String?  @default("Serviço")
  telefoneContato      String?  @default("(11) 99999-8888")
  emailContato         String?  @default("contato@empresa.com")
  endereco             String?  @default("Av. Principal, 1000 - Centro")
  corTemaPrimaria      String?  @default("#0f766e")
  // Desligado: comissão some dos serviços e dos relatórios
  usarComissao         Boolean  @default(true)
  // Ligado: agendar (pela equipe) e cadastrar cliente exigem ficha de anamnese preenchida
  exigirAnamnese       Boolean  @default(false)
  // Serviço "por habilidade": 'sempre' (totem e agenda exigem), 'apenas_totem' (agenda só avisa) ou 'desligado'
  exigenciaHabilidades String   @default("sempre")
  // Horário de funcionamento: vale para a agenda da equipe, o totem e a grade. Limite = último início aceito (null = até fechar)
  horaAbertura          String   @default("09:00")
  horaFechamento        String   @default("21:00")
  horaLimiteAgendamento String?
  diasFuncionamento     Int[]    @default([0, 1, 2, 3, 4, 5, 6])
  // Exceções por data: [{ data: "AAAA-MM-DD", fechado, abertura, fechamento, motivo }] (shared/agenda.ts DiaEspecial)
  diasEspeciais         Json     @default("[]")
  // Lembretes de WhatsApp escritos pela casa, com chaves ({nome}, {horario}...). Vazio = mensagem padrão; várias = sorteia
  mensagensLembrete     String[] @default([])
  // Lembrete pergunta "1 = Sim, confirmo / 2 = Não poderei ir" (respostas lidas pelo WhatsApp por QR code)
  lembretePedeConfirmacao Boolean @default(false)
  // Versão do formulário de anamnese (CampoFormulario). 0 = ainda não inicializado: o primeiro uso cria os campos do segmento
  formularioVersao     Int      @default(0)
  atualizadoEm         DateTime @updatedAt
}
// Trilha de auditoria: cada abertura do histórico (com dados de saúde) de um cliente.
// Sem chave estrangeira de propósito: o registro sobrevive à exclusão do cliente ou do colaborador.
model AcessoHistoricoCliente {
  id            String   @id @default(uuid())
  colaboradorId String
  clienteId     String
  ip            String?
  registros     Int
  criadoEm      DateTime @default(now())

  @@index([clienteId, criadoEm])
  @@index([colaboradorId, criadoEm])
}

// Quem mudou o quê nas decisões financeiras e de catálogo (preço, comissão, serviço fora de linha, cobrança)
model RegistroAuditoria {
  id        String   @id @default(uuid())
  usuarioId String?
  acao      String
  alvo      String
  antes     Json?
  depois    Json?
  criadoEm  DateTime @default(now())

  @@index([criadoEm])
}

// Pergunta do formulário de anamnese configurável (shared/formularioAnamnese.ts). Nunca é apagada: arquivar = ativa false
model CampoFormulario {
  id              String   @id @default(uuid())
  // Slug estável: liga a pergunta aos campos legados da ficha (ex.: "gestante")
  chave           String   @unique
  rotulo          String
  ajuda           String?
  tipo            String   // 'sim_nao' | 'escolha_unica' | 'multipla_escolha' | 'texto_livre'
  opcoes          String[] @default([])
  canal           String   @default("ambos") // 'ambos' | 'apenas_totem' | 'apenas_profissional'
  obrigatorio     Boolean  @default(false)
  dadoSensivel    Boolean  @default(true)
  respostasAlerta String[] @default([])
  ordem           Int      @default(0)
  ativa           Boolean  @default(true)
  // Versão do formulário em que este campo mudou por último
  versao          Int      @default(1)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
}

// Ficha preenchida: cópia imutável das perguntas e respostas de quando foi salva (renomear ou arquivar um campo
// depois não muda a ficha antiga). vinculadaAoCliente false = respondida no totem por um cadastro já existente:
// fica só no agendamento (quem está no totem não provou ser o dono do cadastro)
model FichaPreenchida {
  id                String   @id @default(uuid())
  clienteId         String
  agendamentoId     String?
  canal             String   // 'totem' | 'profissional'
  vinculadaAoCliente Boolean @default(true)
  versaoFormulario  Int
  // { versaoFormulario, preenchidoEm, preenchidoPorCanal, itens: [{ campoId, chave, rotulo, tipo, valor, alerta, dadoSensivel }] }
  snapshot          Json
  alertas           String[] @default([])
  preenchidoPorId   String?
  preenchidoEm      DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, preenchidoEm])
  @@index([agendamentoId])
}
