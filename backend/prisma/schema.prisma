generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Colaborador {
  id            String        @id @default(uuid())
  nome          String
  email         String?       @unique
  senha         String?
  especialidade String
  cargo         String?
  tipoEscala    String?       @default("6x1")
  folgasDomingoNoMes Int?     @default(2)
  cargaHorariaSemanal Int?    @default(40)
  habilidades   String[]      @default([])
  papel         String        @default("collaborator")
  ativo         Boolean       @default(true)
  diasTrabalho  String?       @default("1,2,3,4,5,6")
  // Incrementada ao trocar senha/e-mail ou reativar a conta: tokens com versão antiga deixam de valer
  versaoToken   Int           @default(0)
  agendamentos  Agendamento[]
  bloqueios     Bloqueio[]
  trocasTurno   SolicitacaoTroca[]
  escalaOverrides EscalaOverride[]
}

model Cliente {
  id           String        @id @default(uuid())
  // Código curto para identificar o cliente na tela e no atendimento (o id é técnico)
  codigo       Int           @unique @default(autoincrement())
  nome         String
  telefone     String?
  cpf          String?
  observacao   String?
  // Preenchido quando o cliente é excluído mas tem histórico: os dados pessoais são apagados e os atendimentos ficam
  removidoEm   DateTime?
  agendamentos Agendamento[]
}

model Servico {
  id                   String        @id @default(uuid())
  nome                 String        @unique
  preco                Float
  duracao              Int?          @default(60)
  icone                String?       @default("spa")
  descricao            String?       @default("")
  categoria            String?       @default("")
  tempoHigienizacaoMin Int?          @default(0)
  comissaoPercentual   Float?
  modoElegibilidade    String        @default("livre")
  cargosPermitidos     String[]      @default([])
  habilidadesPermitidas String[]     @default([])
  profissionaisPermitidos String[]   @default([])
  // Inativo: some do totem e de novos agendamentos, mas continua no histórico
  ativo                Boolean       @default(true)
  // Posição no catálogo (menor primeiro)
  ordem                Int           @default(0)
  agendamentos         Agendamento[]
}

model Sala {
  id           String        @id @default(uuid())
  nome         String        @unique
  numero       Int?
  capacidade   Int           @default(1)
  ativa        Boolean       @default(true)
  descricao    String?
  agendamentos Agendamento[]
}

model Agendamento {
  id               String      @id @default(uuid())
  data             DateTime
  status           String?     @default("scheduled")
  colaboradorId    String
  clienteId        String
  salaId           String?
  valorTotal       Float?
  // Comissão do profissional gravada junto com o valor (percentual do serviço no dia)
  valorComissao    Float?
  valorSinal       Float?
  statusPagamento  String?     @default("pendente")
  metodoPagamento  String?
  pixQrCode        String?
  pixCopiaECola    String?
  lockExpiresAt    DateTime?
  reservaOrigem    String?     @default("interno")
  observacoesSaude String?
  atualizadoEm     DateTime    @default(now()) @updatedAt
  // Reserva do totem que originou o agendamento (garante uma confirmação por reserva)
  reservaToken     String?     @unique

  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  cliente       Cliente     @relation(fields: [clienteId], references: [id])
  sala          Sala?       @relation(fields: [salaId], references: [id])
  servicos      Servico[]
}

model Bloqueio {
  id            String      @id @default(uuid())
  data          String
  horaInicio    String
  horaFim       String
  motivo        String
  colaboradorId String

  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
}

model SolicitacaoTroca {
  id                String      @id @default(uuid())
  colaboradorId      String
  dataOriginal       String
  dataSolicitada     String
  motivo             String
  status             String      @default("pendente")
  respostaObservacao String?
  respondidoPorId    String?
  criadoEm           DateTime    @default(now())
  atualizadoEm       DateTime    @updatedAt

  colaborador        Colaborador @relation(fields: [colaboradorId], references: [id])

  @@index([colaboradorId])
  @@index([status])
}

model EscalaOverride {
  key           String      @id
  colaboradorId String
  data          String
  tipo          String?
  turno         String?
  descricao     String?
  atualizadoEm  DateTime    @updatedAt

  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])

  @@index([colaboradorId])
  @@index([data])
}

model ConfiguracaoAutoatendimento {
  id                           String   @id @default("default")
  ativo                        Boolean  @default(true)
  exigirPagamento              Boolean  @default(true)
  percentualSinal              Float    @default(40.0)
  tempoLockMinutos             Int      @default(10)
  permitirCancelamento         Boolean  @default(true)
  tempoMinimoCancelamentoHoras Int      @default(4)
  instrucoesCheckin            String?  @default("Chegue com 10 minutos de antecedência para recepção e confirmação do seu atendimento.")
  mensagemBoasVindas           String?  @default("Bem-vindo ao nosso sistema de autoatendimento. Reserve seu horário com facilidade.")
  atualizadoEm                 DateTime @updatedAt
}

model ConfiguracaoEmpresa {
  id                   String   @id @default("default")
  nomeEmpresa          String   @default("OmniGestão - Atendimentos & Agendamentos")
  segmento             String   @default("geral") // 'geral', 'beleza_barbearia', 'clinica_saude', 'spa_bemestar', 'estudio_fitness'
  slogan               String?  @default("Gestão inteligente e experiência de excelência para seus clientes.")
  icone                String?  @default("storefront")
  termoAtendimento     String?  @default("Atendimento")
  termoProfissional    String?  @default("Profissional")
  termoEspaco          String?  @default("Sala / Espaço")
  termoServico         String?  @default("Serviço")
  telefoneContato      String?  @default("(11) 99999-8888")
  emailContato         String?  @default("contato@empresa.com")
  endereco             String?  @default("Av. Principal, 1000 - Centro")
  corTemaPrimaria      String?  @default("#0f766e")
  // Desligado: comissão some dos serviços e dos relatórios
  usarComissao         Boolean  @default(true)
  atualizadoEm         DateTime @updatedAt
}
// Trilha de auditoria: cada abertura do histórico (com dados de saúde) de um cliente.
// Sem chave estrangeira de propósito: o registro sobrevive à exclusão do cliente ou do colaborador.
model AcessoHistoricoCliente {
  id            String   @id @default(uuid())
  colaboradorId String
  clienteId     String
  ip            String?
  registros     Int
  criadoEm      DateTime @default(now())

  @@index([clienteId, criadoEm])
  @@index([colaboradorId, criadoEm])
}
