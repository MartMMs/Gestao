# HTTPS (TLS) na frente do portal, do totem, do painel da TV e da API. Troque "suaempresa.com" e os caminhos.
# Requer nginx 1.25.1 ou mais novo ("http2 on"; "ssl_reject_handshake" exige 1.19.4+).
# Certificado gratuito:
#   sudo certbot certonly --nginx -d app.suaempresa.com -d autoatendimento.suaempresa.com -d tv.suaempresa.com -d api.suaempresa.com
# Backend com NODE_ENV=production e TRUST_PROXY=1 (cookie "secure" e IP real no rate limit).
# No build do frontend, preencha VITE_AUTOATENDIMENTO_HOST e VITE_TV_HOST com os hosts exatos abaixo: sem eles vale
# qualquer host que comece com "autoatendimento." ou "tv.".

server_tokens off;   # não anuncia a versão do nginx

# WebSocket (Socket.IO): "upgrade" só quando o navegador pede, "close" no resto
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Todo acesso por HTTP vira HTTPS
server {
  listen 80;
  listen [::]:80;
  server_name app.suaempresa.com autoatendimento.suaempresa.com tv.suaempresa.com api.suaempresa.com;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

# Host desconhecido (IP direto, domínio parecido apontado para cá): fecha a conexão sem responder
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  return 444;
}
server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  ssl_reject_handshake on;
}

# Parametros TLS comuns (so TLS 1.2/1.3, cifras modernas)
ssl_certificate     /etc/letsencrypt/live/app.suaempresa.com/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/app.suaempresa.com/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;
ssl_session_timeout 1d;
ssl_session_cache shared:TLS:10m;
ssl_session_tickets off;
ssl_stapling on;
ssl_stapling_verify on;

# Portal, totem e painel da TV: mesmo build do frontend (dist/)
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name app.suaempresa.com autoatendimento.suaempresa.com tv.suaempresa.com;
  root /var/www/gestao/frontend/dist;

  # includeSubDomains força HTTPS em TODOS os subdomínios de suaempresa.com (inclusive sistemas de terceiros).
  # Se algum subdomínio ainda não tem HTTPS, tire o includeSubDomains.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  # CSP: só o próprio site, a API, as fontes do Google, os avatares (dicebear), a previsão do tempo do painel
  # (open-meteo) e o som de chamada (mixkit). style-src 'unsafe-inline' é do React (atributo style).
  # Na primeira vez, troque o nome do cabeçalho por Content-Security-Policy-Report-Only e veja o console do navegador.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://api.dicebear.com; media-src 'self' https://assets.mixkit.co; connect-src 'self' https://api.suaempresa.com wss://api.suaempresa.com https://api.open-meteo.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  add_header X-Frame-Options DENY always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

  location / { try_files $uri /index.html; }
}

# API + Socket.IO (o Node continua em HTTP so na maquina local)
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name api.suaempresa.com;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location / {
    proxy_pass http://127.0.0.1:3333;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;              # WebSocket do tempo real
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 70s;
  }
}
