# Copie para .env e ajuste os valores
DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/gestao_db"
# Obrigatorio: o servidor nao sobe sem ele. Gere com: openssl rand -hex 32
JWT_SECRET=
PORT=3333
# Validade do token de login (padrao 2h, maximo 12h)
JWT_EXPIRES_IN=2h
# Redis para travas e limites (obrigatorio em producao; em desenvolvimento, sem Redis usa memoria)
REDIS_URL=
# Origens aceitas pela API e pelo socket (separadas por virgula). Obrigatorio em producao.
# Vazio (so fora de producao) = a propria maquina e a rede local (192.168.x, 10.x, 172.16-31.x).
# Inclua tambem o subdominio do totem (ex.: https://app.suaempresa.com,https://autoatendimento.suaempresa.com)
CORS_ORIGINS=
# Opcional: atras de proxy reverso (nginx), informe o numero de proxies (ex.: 1) ou os IPs deles. "true" nao e aceito.
TRUST_PROXY=
# Segredo do webhook do gateway de pagamento (HMAC-SHA256). Sem ele, o gateway conta como desconectado: o botao
# "exigir pagamento" fica salvo, mas o totem confirma a reserva com pagamento na recepcao.
PAYMENT_WEBHOOK_SECRET=
# Dias ate marcar agendamentos nunca concluidos como "no_show" (0 desativa)
LIMPEZA_AGENDAMENTOS_DIAS=30
# Senha dos usuarios de teste E2E (npm run seed:ci) e do seed de demonstracao
E2E_PASSWORD=
SEED_PASSWORD=
# Limites do totem publico (padrao 60 requisicoes/min e 5 reservas a cada 10 min por IP)
TOTEM_MAX_REQUISICOES_POR_MINUTO=
TOTEM_MAX_RESERVAS_POR_IP=
# Reservas futuras ativas do totem por telefone (padrao 2)
TOTEM_MAX_RESERVAS_POR_TELEFONE=

# Frontend (build do Vite). O totem de autoatendimento roda num subdominio proprio, sem login.
# Precisa ser um SUBDOMINIO (outra origem): num caminho do mesmo host (app.x.com/autoatendimento) a sessao
# da equipe nao fica isolada do aparelho do totem.
# Host(s) do totem, separados por virgula; vazio = qualquer host que comece com "autoatendimento."
VITE_AUTOATENDIMENTO_HOST=
# Endereco completo do totem, usado pelo botao da tela de login (vazio = abre o totem dentro do portal)
VITE_AUTOATENDIMENTO_URL=
# Painel de TV: coordenadas da clinica para o clima (vazio = painel sem clima, nenhuma chamada a terceiros)
VITE_TV_LATITUDE=
VITE_TV_LONGITUDE=
